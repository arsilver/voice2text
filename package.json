{
  "name": "craftvoice",
  "version": "0.1.0",
  "description": "Local-first desktop voice dictation for developer intent.",
  "private": true,
  "main": "dist/main/index.mjs",
  "scripts": {
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "dev:main": "vite build --watch --config vite.main.config.ts",
    "dev:preload": "vite build --watch --config vite.preload.config.ts",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 dist/main/index.mjs dist/preload/index.cjs && node scripts/electron-launcher.mjs . --renderer-url=http://127.0.0.1:5173",
    "dev": "concurrently -k -n main,preload,renderer,electron -c auto \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "start": "node scripts/electron-launcher.mjs .",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "test": "tsc -p tsconfig.test.json && node --test tmp/test-dist/main/startup.test.js tmp/test-dist/main/recording-workflow.test.js tmp/test-dist/main/db/settings-safety.test.js tmp/test-dist/main/transcribe/whisper-runtime.test.js tmp/test-dist/main/utils/file-logger.test.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-rebuild -f -w better-sqlite3,@nut-tree-fork/nut-js",
    "assets:download": "npm run whisper:download && npm run model:download",
    "whisper:download": "node scripts/download-whisper.mjs",
    "model:download": "node scripts/download-model.mjs"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "4.2.6",
    "better-sqlite3": "12.6.2",
    "electron-store": "11.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.4",
    "uuid": "13.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "electron": "40.8.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vite": "7.3.1",
    "wait-on": "9.0.1"
  }
}
